{
  "buildCommand": "node scripts/build-public-site.cjs",
  "outputDirectory": ".public-site",
  "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_GIT_COMMIT_REF === 'main' && (process.env.VERCEL_GIT_COMMIT_MESSAGE || '').includes('[reviewed-cli-promotion]') ? 0 : 1)\"",
  "redirects": [
    {
      "source": "/ai-faq.html",
      "destination": "/ai-answer-hub.html",
      "permanent": true
    },
    {
      "source": "/ai-tutorial.html",
      "destination": "/ai-answer-hub.html",
      "permanent": true
    },
    {
      "source": "/en/ai-tutorial.html",
      "destination": "/en/ai-faq.html",
      "permanent": true
    },
    {
      "source": "/en/geo-promotion.html",
      "destination": "/en/services.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(llms.txt|ai-search-ready.txt|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(geo-feed.json|schema-markup.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/cases-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
